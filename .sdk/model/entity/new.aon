# Entity: new

main: kit: entity: new: {

  alias: field: {}

  fields: [
    {
      name: "breakingNews"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "new"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/ru/breaking-news"
          segments: [
            {
              lit: "ru"
            }
            {
              lit: "breaking-news"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
